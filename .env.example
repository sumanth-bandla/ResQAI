# Browser-safe Supabase URL and publishable key for Auth and authenticated read-only data.
# Get these from the verified project's Supabase > Project Settings > API Keys.
# Public email/password registration also requires the Supabase Email provider to be enabled.
VITE_SUPABASE_URL=https://hopopcdfpjwjshkrfmki.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# Import-only secret: keep this key server-side and in .env.local only.
# Never add a service_role/secret key to a VITE_ variable or browser code.
SUPABASE_URL=https://hopopcdfpjwjshkrfmki.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Optional Socrata application token for higher public API rate limits.
SF_OPEN_DATA_APP_TOKEN=
